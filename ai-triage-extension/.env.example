# SOPHiA DDM AI Triage + Chatbot — backend env vars.
# Copy this file to .env and fill in at least one provider key.
#
# .env is gitignored; never commit it.

# ---------------------------------------------------------------------
# Choose at least ONE LLM provider. The model strings below dispatch:
# anything starting with "gemini" → Google; anything else → Anthropic.
# ---------------------------------------------------------------------

# --- Google Gemini (free tier works for a handful of cases) ---
# Create at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key

# --- Anthropic Claude (paid; more reliable under load) ---
# Create at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ---------------------------------------------------------------------
# Model selection. Defaults to gemini-2.5-flash for both. Override to
# use Claude:
# ---------------------------------------------------------------------
# LLM_MODEL=claude-sonnet-4-6
# CHAT_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------
# Optional: backend port (the extension hardcodes 8000 — only change
# this if you also update extension/content.js BACKEND and the manifest
# host_permissions).
# ---------------------------------------------------------------------
# PORT=8000
